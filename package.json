{
  "name": "@auggieteo/dsh-output-styles",
  "description": "Persistent output styles for DeepSeek Harness Web: pick a built-in style or create named styles from the Settings page",
  "version": "0.4.1",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "auggieteo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auggie246/dsh-output-styles.git"
  },
  "homepage": "https://github.com/auggie246/dsh-output-styles#readme",
  "bugs": "https://github.com/auggie246/dsh-output-styles/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "output-style"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-web"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/",
    "dynamic/",
    "scripts/",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run bundle:dynamic",
    "bundle:dynamic": "node scripts/bundle-dynamic.mjs",
    "test": "node --check lib/client.js && node --input-type=module --check < lib/index.js && node --input-type=module --check < lib/remote.js && node --input-type=module --check < lib/catalog.js && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  }
}
